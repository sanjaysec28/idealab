{
  "entities": {
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "IDEA LAB student identity, academic details, and coordinator-controlled membership status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the student."
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Student full name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160,
          "description": "Verified Saveetha college email address."
        },
        "registrationNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9\\-]+$",
          "description": "Student college registration number."
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Academic department."
        },
        "academicYear": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "description": "Current academic year (e.g., 3rd Year)."
        },
        "membershipStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Coordinator-controlled membership approval state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the membership request was submitted."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last update."
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when approved by a coordinator."
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID or identifier of the approving coordinator."
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional note explaining membership rejection."
        }
      },
      "required": [
        "uid",
        "fullName",
        "email",
        "registrationNumber",
        "department",
        "academicYear",
        "membershipStatus",
        "createdAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized IDEA LAB coordinator/admin account marker.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["coordinator", "admin"]
        }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/students/{uid}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Student membership profiles keyed by Firebase Auth UID."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authorized IDEA LAB admin/coordinator accounts (managed via backend/console)."
    }
  }
}
