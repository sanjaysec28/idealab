{
  "entities": {
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "IDEA LAB student identity, academic details, and timetable onboarding status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the student."
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Student full name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Verified student email address."
        },
        "registrationNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9\\-]+$",
          "description": "Optional college registration number."
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Academic department."
        },
        "academicYear": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "description": "Current academic year (e.g., 3rd Year)."
        },
        "currentAcademicYear": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "description": "Academic year displayed on profile & timetable."
        },
        "currentSemester": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "Current semester label (e.g., Semester 5)."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional profile photo URL in Firebase Storage or default asset."
        },
        "avatarPresetId": {
          "type": "string",
          "maxLength": 64,
          "description": "Identifier of selected default avatar preset."
        },
        "bannerURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional cover banner URL in Firebase Storage or default asset."
        },
        "bannerPresetId": {
          "type": "string",
          "maxLength": 64,
          "description": "Identifier of selected default cover banner preset."
        },
        "bio": {
          "type": "string",
          "maxLength": 600,
          "description": "Short student biography."
        },
        "location": {
          "type": "string",
          "maxLength": 120,
          "description": "Student campus or city location."
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional student contact phone number."
        },
        "skills": {
          "type": "array",
          "maxItems": 25,
          "description": "Technical and creative skill tags."
        },
        "interests": {
          "type": "array",
          "maxItems": 25,
          "description": "Innovation and research interest tags."
        },
        "socialLinks": {
          "type": "object",
          "description": "Validated LinkedIn, GitHub, and portfolio URLs."
        },
        "timetableCompleted": {
          "type": "boolean",
          "description": "True once the student has submitted a valid timetable in Firestore."
        },
        "timetableStatus": {
          "type": "string",
          "enum": ["not_submitted", "submitted"],
          "description": "Current student timetable completion state."
        },
        "timetableUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the timetable was last submitted."
        },
        "profileSetupCompleted": {
          "type": "boolean",
          "description": "True once initial academic profile & timetable setup are saved."
        },
        "membershipStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Optional legacy field preserved read-only for existing accounts."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the student profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last profile update."
        }
      },
      "required": ["uid", "fullName", "email", "createdAt"]
    },
    "StudentTimetable": {
      "title": "StudentTimetable",
      "description": "Canonical submitted weekly class timetable for an authenticated student.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "semester": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "academicYear": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24
        },
        "selectedWeekdays": {
          "type": "array",
          "maxItems": 6
        },
        "selectedTimeSlots": {
          "type": "array",
          "maxItems": 4
        },
        "subjectCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24
        },
        "subjectNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24
        },
        "facultyNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24
        },
        "totalSubjects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "classDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "totalClasses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "submissionStatus": {
          "type": "string",
          "enum": ["submitted"]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "semester",
        "academicYear",
        "department",
        "classes",
        "selectedWeekdays",
        "selectedTimeSlots",
        "subjectCodes",
        "subjectNames",
        "facultyNames",
        "totalSubjects",
        "classDays",
        "totalClasses",
        "submissionStatus",
        "version",
        "submittedAt",
        "updatedAt"
      ]
    },
    "StudentAvailability": {
      "title": "StudentAvailability",
      "description": "Derived weekly free slots and opt-in collaboration availability for a student.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "freeSlots": {
          "type": "array",
          "maxItems": 24
        },
        "totalFreePeriods": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "totalOccupiedPeriods": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "utilizationPercentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "isOptedIn": {
          "type": "boolean"
        },
        "hasSubmittedTimetable": {
          "type": "boolean"
        },
        "timetableVersion": {
          "type": "integer",
          "minimum": 1
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "academicYear": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "avatarPresetId": {
          "type": "string",
          "maxLength": 64
        },
        "skills": {
          "type": "array",
          "maxItems": 25
        },
        "emailVerified": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "freeSlots",
        "totalFreePeriods",
        "totalOccupiedPeriods",
        "utilizationPercentage",
        "isOptedIn",
        "hasSubmittedTimetable",
        "timetableVersion",
        "updatedAt"
      ]
    },
    "CampusProject": {
      "title": "CampusProject",
      "description": "Published student innovation project in IDEA LAB.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "minLength": 4, "maxLength": 2000 },
        "category": { "type": "string", "minLength": 2, "maxLength": 40 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "tags": { "type": "array", "maxItems": 12 },
        "creatorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "creatorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "creatorAvatar": { "type": "string", "maxLength": 1000 },
        "teamMembers": { "type": "array", "maxItems": 10 },
        "likesCount": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "category", "creatorUid", "creatorName", "likesCount", "status", "createdAt", "updatedAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Published student post in the IDEA LAB community feed.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "authorDepartment": { "type": "string", "maxLength": 80 },
        "authorYear": { "type": "string", "maxLength": 24 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "authorAvatarPresetId": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "enum": ["Projects", "Ideas", "Team Up", "Updates"] },
        "content": { "type": "string", "minLength": 2, "maxLength": 1200 },
        "hashtags": { "type": "array", "maxItems": 8 },
        "likesCount": { "type": "integer", "minimum": 0 },
        "commentsCount": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["published", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorName", "category", "content", "likesCount", "commentsCount", "status", "createdAt", "updatedAt"]
    },
    "CommunityPostLike": {
      "title": "CommunityPostLike",
      "description": "Like marker keyed by student UID on a community post.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    },
    "CommunityPostComment": {
      "title": "CommunityPostComment",
      "description": "Comment reply on a published community post.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorName", "content", "createdAt"]
    },
    "CampusEvent": {
      "title": "CampusEvent",
      "description": "Coordinator-published IDEA LAB workshop, hackathon, or demo day event.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 2000 },
        "eventDate": { "type": "string", "format": "date-time" },
        "timeRange": { "type": "string", "minLength": 2, "maxLength": 60 },
        "location": { "type": "string", "minLength": 2, "maxLength": 140 },
        "category": { "type": "string", "maxLength": 40 },
        "thumbnail": { "type": "string", "maxLength": 1000 },
        "capacity": { "type": "integer", "minimum": 1 },
        "registeredCount": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["draft", "published", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "eventDate", "timeRange", "location", "status", "createdAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Coordinator-approved contribution points and standing for a student.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "department": { "type": "string", "minLength": 2, "maxLength": 80 },
        "academicYear": { "type": "string", "maxLength": 24 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "avatarPresetId": { "type": "string", "maxLength": 64 },
        "approvedPoints": { "type": "integer", "minimum": 0 },
        "projectsCompleted": { "type": "integer", "minimum": 0 },
        "badge": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["active", "hidden"] },
        "awardedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "department", "approvedPoints", "status", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized IDEA LAB admin account marker.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["coordinator", "admin"]
        }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/students/{uid}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Student profile and timetable completion records keyed by Firebase Auth UID."
    },
    "/students/{uid}/timetable/{docId}": {
      "schema": { "$ref": "#/entities/StudentTimetable" },
      "description": "Submitted student timetable stored under docId 'current'."
    },
    "/students/{uid}/availability/{docId}": {
      "schema": { "$ref": "#/entities/StudentAvailability" },
      "description": "Derived student free-period availability and collaboration opt-in state under docId 'current'."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/CampusProject" },
      "description": "Published student projects displayed on the IDEA LAB homepage and projects hub."
    },
    "/communityPosts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Published student community posts displayed in the IDEA LAB community feed."
    },
    "/communityPosts/{postId}/likes/{uid}": {
      "schema": { "$ref": "#/entities/CommunityPostLike" },
      "description": "Per-student like record for community posts."
    },
    "/communityPosts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/CommunityPostComment" },
      "description": "Student comments on community posts."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CampusEvent" },
      "description": "Coordinator-published upcoming IDEA LAB workshops and hackathons."
    },
    "/leaderboard/{uid}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Coordinator-approved contribution points and rankings (strictly read-only for students)."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authorized IDEA LAB admin accounts (managed via backend/console)."
    }
  }
}
