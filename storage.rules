rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Student profile photos and custom cover banners scoped strictly to the authenticated student UID
    match /students/{uid}/profile/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isEmailVerified() && isValidImageUpload();
      allow delete: if isOwner(uid) && isEmailVerified();
    }

    // Deny all other storage paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
