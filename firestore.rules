rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEmail(email) {
      return email is string
        && email.size() >= 5
        && email.size() <= 160
        && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isVerifiedStudent() {
      return isEmailVerified() && isValidEmail(request.auth.token.email);
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'sanjaykumarbjc@gmail.com'
      );
    }

    function isOptionalBoundedString(data, field, minLen, maxLen) {
      return !(field in data) || (
        data[field] is string
        && data[field].size() >= minLen
        && data[field].size() <= maxLen
      );
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isOptionalStringList(data, field, maxItems, maxItemLen) {
      return !(field in data) || (
        data[field] is list
        && data[field].size() <= maxItems
        && (
          data[field].size() == 0 || (
            data[field][0] is string
            && data[field][0].size() >= 1
            && data[field][0].size() <= maxItemLen
          )
        )
      );
    }

    function isOptionalSocialLinks(data) {
      return !('socialLinks' in data) || (
        data.socialLinks is map
        && data.socialLinks.keys().hasOnly(['linkedin', 'github', 'portfolio'])
        && isOptionalBoundedString(data.socialLinks, 'linkedin', 0, 300)
        && isOptionalBoundedString(data.socialLinks, 'github', 0, 300)
        && isOptionalBoundedString(data.socialLinks, 'portfolio', 0, 300)
      );
    }

    function isValidStudentFields(data, uid) {
      return data.uid is string
        && data.uid == uid
        && isValidId(data.uid)
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 100
        && isValidEmail(data.email)
        && data.createdAt is timestamp
        && (!( 'registrationNumber' in data ) || (
          data.registrationNumber is string
          && data.registrationNumber.size() >= 4
          && data.registrationNumber.size() <= 32
          && data.registrationNumber.matches('^[A-Za-z0-9\\-]+$')
        ))
        && isOptionalBoundedString(data, 'department', 2, 80)
        && isOptionalBoundedString(data, 'academicYear', 2, 24)
        && isOptionalBoundedString(data, 'currentAcademicYear', 2, 24)
        && isOptionalBoundedString(data, 'currentSemester', 1, 24)
        && isOptionalBoundedString(data, 'photoURL', 0, 1000)
        && isOptionalBoundedString(data, 'avatarPresetId', 0, 64)
        && isOptionalBoundedString(data, 'bannerURL', 0, 1000)
        && isOptionalBoundedString(data, 'bannerPresetId', 0, 64)
        && isOptionalBoundedString(data, 'bio', 0, 600)
        && isOptionalBoundedString(data, 'location', 0, 120)
        && isOptionalBoundedString(data, 'phoneNumber', 0, 32)
        && isOptionalStringList(data, 'skills', 25, 60)
        && isOptionalStringList(data, 'interests', 25, 60)
        && isOptionalSocialLinks(data)
        && isOptionalBool(data, 'timetableCompleted')
        && isOptionalBool(data, 'profileSetupCompleted')
        && (!( 'timetableStatus' in data ) || data.timetableStatus in ['not_submitted', 'submitted'])
        && (!( 'timetableUpdatedAt' in data ) || data.timetableUpdatedAt is timestamp)
        && (!( 'updatedAt' in data ) || data.updatedAt is timestamp);
    }

    function isValidLiveStudentCreate(data, uid) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt'])
        && data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'registrationNumber',
          'department',
          'academicYear',
          'currentAcademicYear',
          'currentSemester',
          'photoURL',
          'avatarPresetId',
          'bannerURL',
          'bannerPresetId',
          'bio',
          'location',
          'phoneNumber',
          'skills',
          'interests',
          'socialLinks',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt',
          'profileSetupCompleted',
          'createdAt',
          'updatedAt'
        ])
        && isValidStudentFields(data, uid)
        && data.uid == request.auth.uid
        && data.email.lower() == request.auth.token.email.lower()
        && data.createdAt == request.time
        && (!( 'updatedAt' in data ) || data.updatedAt == request.time)
        && (!( 'timetableUpdatedAt' in data ) || data.timetableUpdatedAt == request.time);
    }

    function isValidLiveStudentSelfUpdate(data, prev, uid) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt'])
        && data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'registrationNumber',
          'department',
          'academicYear',
          'currentAcademicYear',
          'currentSemester',
          'photoURL',
          'avatarPresetId',
          'bannerURL',
          'bannerPresetId',
          'bio',
          'location',
          'phoneNumber',
          'skills',
          'interests',
          'socialLinks',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt',
          'profileSetupCompleted',
          'membershipStatus',
          'approvedAt',
          'approvedBy',
          'rejectionReason',
          'createdAt',
          'updatedAt'
        ])
        && isValidStudentFields(data, uid)
        && data.uid == prev.uid
        && data.email == prev.email
        && data.createdAt == prev.createdAt
        && (!('registrationNumber' in prev) || data.registrationNumber == prev.registrationNumber)
        && data.updatedAt == request.time
        && (!( 'timetableUpdatedAt' in data ) || data.timetableUpdatedAt == request.time || (('timetableUpdatedAt' in prev) && data.timetableUpdatedAt == prev.timetableUpdatedAt))
        && data.diff(prev).affectedKeys().hasOnly([
          'fullName',
          'department',
          'academicYear',
          'currentAcademicYear',
          'currentSemester',
          'photoURL',
          'avatarPresetId',
          'bannerURL',
          'bannerPresetId',
          'bio',
          'location',
          'phoneNumber',
          'skills',
          'interests',
          'socialLinks',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt',
          'profileSetupCompleted',
          'updatedAt'
        ]);
    }

    function isValidAdminStudentUpdate(data, prev, uid) {
      return isValidStudentFields(data, uid)
        && data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'registrationNumber',
          'department',
          'academicYear',
          'currentAcademicYear',
          'currentSemester',
          'photoURL',
          'avatarPresetId',
          'bannerURL',
          'bannerPresetId',
          'bio',
          'location',
          'phoneNumber',
          'skills',
          'interests',
          'socialLinks',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt',
          'profileSetupCompleted',
          'membershipStatus',
          'approvedAt',
          'approvedBy',
          'rejectionReason',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == prev.uid
        && data.email == prev.email
        && data.createdAt == prev.createdAt;
    }

    function isValidTimetableWrite(data, uid) {
      return data.keys().hasAll([
          'uid',
          'semester',
          'academicYear',
          'department',
          'classes',
          'selectedWeekdays',
          'selectedTimeSlots',
          'subjectCodes',
          'subjectNames',
          'facultyNames',
          'totalSubjects',
          'classDays',
          'totalClasses',
          'submissionStatus',
          'version',
          'submittedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'semester',
          'academicYear',
          'department',
          'classes',
          'selectedWeekdays',
          'selectedTimeSlots',
          'subjectCodes',
          'subjectNames',
          'facultyNames',
          'totalSubjects',
          'classDays',
          'totalClasses',
          'submissionStatus',
          'version',
          'submittedAt',
          'updatedAt'
        ])
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 24
        && data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 24
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 80
        && data.classes is list && data.classes.size() >= 1 && data.classes.size() <= 24 && data.classes[0] is map
        && data.selectedWeekdays is list && data.selectedWeekdays.size() >= 1 && data.selectedWeekdays.size() <= 6 && data.selectedWeekdays.hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && data.selectedTimeSlots is list && data.selectedTimeSlots.size() >= 1 && data.selectedTimeSlots.size() <= 4 && data.selectedTimeSlots.hasOnly(['slot-1', 'slot-2', 'slot-3', 'slot-4'])
        && data.subjectCodes is list && data.subjectCodes.size() >= 1 && data.subjectCodes.size() <= 24 && data.subjectCodes[0] is string
        && data.subjectNames is list && data.subjectNames.size() >= 1 && data.subjectNames.size() <= 24 && data.subjectNames[0] is string
        && data.facultyNames is list && data.facultyNames.size() >= 1 && data.facultyNames.size() <= 24 && data.facultyNames[0] is string
        && data.totalSubjects is int && data.totalSubjects >= 1 && data.totalSubjects <= 24
        && data.classDays is int && data.classDays >= 1 && data.classDays <= 6
        && data.totalClasses is int && data.totalClasses >= 1 && data.totalClasses <= 24
        && data.submissionStatus == 'submitted'
        && data.version is int && data.version >= 1 && data.version <= 1000
        && data.submittedAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidAvailabilityWrite(data, uid) {
      return data.keys().hasAll([
          'uid',
          'freeSlots',
          'totalFreePeriods',
          'totalOccupiedPeriods',
          'utilizationPercentage',
          'isOptedIn',
          'hasSubmittedTimetable',
          'timetableVersion',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'freeSlots',
          'totalFreePeriods',
          'totalOccupiedPeriods',
          'utilizationPercentage',
          'isOptedIn',
          'hasSubmittedTimetable',
          'timetableVersion',
          'fullName',
          'department',
          'academicYear',
          'photoURL',
          'avatarPresetId',
          'skills',
          'emailVerified',
          'updatedAt'
        ])
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.freeSlots is list && data.freeSlots.size() <= 24 && (data.freeSlots.size() == 0 || data.freeSlots[0] is map)
        && data.totalFreePeriods is int && data.totalFreePeriods >= 0 && data.totalFreePeriods <= 24
        && data.totalOccupiedPeriods is int && data.totalOccupiedPeriods >= 0 && data.totalOccupiedPeriods <= 24
        && (data.totalFreePeriods + data.totalOccupiedPeriods) == 24
        && data.utilizationPercentage is int && data.utilizationPercentage >= 0 && data.utilizationPercentage <= 100
        && data.isOptedIn is bool
        && data.hasSubmittedTimetable is bool
        && (!data.isOptedIn || (data.hasSubmittedTimetable == true && data.totalFreePeriods > 0))
        && data.timetableVersion is int && data.timetableVersion >= 1 && data.timetableVersion <= 1000
        && isOptionalBoundedString(data, 'fullName', 2, 100)
        && isOptionalBoundedString(data, 'department', 2, 80)
        && isOptionalBoundedString(data, 'academicYear', 2, 24)
        && isOptionalBoundedString(data, 'photoURL', 0, 1000)
        && isOptionalBoundedString(data, 'avatarPresetId', 0, 64)
        && isOptionalStringList(data, 'skills', 25, 60)
        && isOptionalBool(data, 'emailVerified')
        && data.updatedAt == request.time;
    }

    function isValidCampusProject(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'category',
          'creatorUid',
          'creatorName',
          'likesCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'tagline',
          'description',
          'category',
          'coverImage',
          'tags',
          'creatorUid',
          'creatorName',
          'creatorAvatar',
          'teamMembers',
          'likesCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && isOptionalBoundedString(data, 'tagline', 0, 200)
        && data.description is string && data.description.size() >= 4 && data.description.size() <= 2000
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 40
        && isOptionalBoundedString(data, 'coverImage', 0, 1000)
        && isOptionalStringList(data, 'tags', 12, 40)
        && data.creatorUid is string && isValidId(data.creatorUid)
        && data.creatorName is string && data.creatorName.size() >= 2 && data.creatorName.size() <= 100
        && isOptionalBoundedString(data, 'creatorAvatar', 0, 1000)
        && (!('teamMembers' in data) || (
          data.teamMembers is list
          && data.teamMembers.size() <= 10
          && (data.teamMembers.size() == 0 || data.teamMembers[0] is map)
        ))
        && data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000
        && data.status in ['draft', 'published', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll([
          'authorUid',
          'authorName',
          'category',
          'content',
          'likesCount',
          'commentsCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorUid',
          'authorName',
          'authorDepartment',
          'authorYear',
          'authorAvatar',
          'authorAvatarPresetId',
          'category',
          'content',
          'hashtags',
          'likesCount',
          'commentsCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.authorUid is string && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && isOptionalBoundedString(data, 'authorDepartment', 0, 80)
        && isOptionalBoundedString(data, 'authorYear', 0, 24)
        && isOptionalBoundedString(data, 'authorAvatar', 0, 1000)
        && isOptionalBoundedString(data, 'authorAvatarPresetId', 0, 64)
        && data.category in ['Projects', 'Ideas', 'Team Up', 'Updates']
        && data.content is string && data.content.size() >= 2 && data.content.size() <= 1200
        && isOptionalStringList(data, 'hashtags', 8, 40)
        && data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000
        && data.commentsCount is int && data.commentsCount >= 0 && data.commentsCount <= 1000000
        && data.status in ['published', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPostComment(data) {
      return data.keys().hasAll(['authorUid', 'authorName', 'content', 'createdAt'])
        && data.keys().hasOnly(['authorUid', 'authorName', 'authorAvatar', 'content', 'createdAt'])
        && data.authorUid == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && isOptionalBoundedString(data, 'authorAvatar', 0, 1000)
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 500
        && data.createdAt == request.time;
    }

    function isValidCampusEvent(data) {
      return data.keys().hasAll(['title', 'eventDate', 'timeRange', 'location', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'title',
          'description',
          'eventDate',
          'timeRange',
          'location',
          'category',
          'thumbnail',
          'capacity',
          'registeredCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && isOptionalBoundedString(data, 'description', 0, 2000)
        && data.eventDate is timestamp
        && data.timeRange is string && data.timeRange.size() >= 2 && data.timeRange.size() <= 60
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 140
        && isOptionalBoundedString(data, 'category', 2, 40)
        && isOptionalBoundedString(data, 'thumbnail', 0, 1000)
        && (!('capacity' in data) || (data.capacity is int && data.capacity >= 1 && data.capacity <= 10000))
        && (!('registeredCount' in data) || (data.registeredCount is int && data.registeredCount >= 0 && data.registeredCount <= 10000))
        && data.status in ['draft', 'published', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, uid) {
      return data.keys().hasAll(['uid', 'fullName', 'department', 'approvedPoints', 'status', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'fullName',
          'department',
          'academicYear',
          'photoURL',
          'avatarPresetId',
          'approvedPoints',
          'projectsCompleted',
          'badge',
          'status',
          'awardedBy',
          'updatedAt'
        ])
        && data.uid == uid
        && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 80
        && isOptionalBoundedString(data, 'academicYear', 0, 24)
        && isOptionalBoundedString(data, 'photoURL', 0, 1000)
        && isOptionalBoundedString(data, 'avatarPresetId', 0, 64)
        && data.approvedPoints is int && data.approvedPoints >= 0 && data.approvedPoints <= 1000000
        && (!('projectsCompleted' in data) || (data.projectsCompleted is int && data.projectsCompleted >= 0 && data.projectsCompleted <= 1000))
        && isOptionalBoundedString(data, 'badge', 0, 60)
        && data.status in ['active', 'hidden']
        && isOptionalBoundedString(data, 'awardedBy', 1, 128)
        && data.updatedAt == request.time;
    }

    match /students/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());

      // Never use exists()/get() in list queries
      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        (isEmailVerified() && request.auth.token.email == 'sanjaykumarbjc@gmail.com')
      );

      allow create: if isValidId(uid)
        && isOwner(uid)
        && isVerifiedStudent()
        && isValidLiveStudentCreate(incoming(), uid);

      allow update: if isValidId(uid) && (
        (isAdmin() && isValidAdminStudentUpdate(incoming(), existing(), uid)) ||
        (isOwner(uid) && isVerifiedStudent() && isValidLiveStudentSelfUpdate(incoming(), existing(), uid))
      );

      allow delete: if isValidId(uid) && isAdmin();

      match /timetable/{docId} {
        allow get: if isValidId(uid) && docId == 'current' && (isOwner(uid) || isAdmin());
        allow list: if isValidId(uid) && docId == 'current' && isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          (isEmailVerified() && request.auth.token.email == 'sanjaykumarbjc@gmail.com')
        );

        allow create: if isValidId(uid)
          && docId == 'current'
          && isOwner(uid)
          && isVerifiedStudent()
          && isValidTimetableWrite(incoming(), uid);

        allow update: if isValidId(uid)
          && docId == 'current'
          && isOwner(uid)
          && isVerifiedStudent()
          && isValidTimetableWrite(incoming(), uid)
          && incoming().uid == existing().uid
          && incoming().version >= existing().version;

        allow delete: if isValidId(uid) && isAdmin();
      }

      match /availability/{docId} {
        allow get: if isValidId(uid) && docId == 'current' && (
          isOwner(uid) ||
          isAdmin() ||
          (
            isVerifiedStudent()
            && existing().isOptedIn == true
            && existing().hasSubmittedTimetable == true
            && existing().totalFreePeriods > 0
          )
        );

        allow list: if isValidId(uid) && docId == 'current' && isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          (isEmailVerified() && request.auth.token.email == 'sanjaykumarbjc@gmail.com') ||
          (
            isVerifiedStudent()
            && resource.data.isOptedIn == true
          )
        );

        allow create: if isValidId(uid)
          && docId == 'current'
          && isOwner(uid)
          && isVerifiedStudent()
          && isValidAvailabilityWrite(incoming(), uid);

        allow update: if isValidId(uid)
          && docId == 'current'
          && isOwner(uid)
          && isVerifiedStudent()
          && isValidAvailabilityWrite(incoming(), uid)
          && incoming().uid == existing().uid
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isOptedIn',
              'fullName',
              'department',
              'academicYear',
              'photoURL',
              'avatarPresetId',
              'skills',
              'emailVerified',
              'updatedAt'
            ]) ||
            incoming().timetableVersion >= existing().timetableVersion
          );

        allow delete: if isValidId(uid) && isAdmin();
      }
    }

    // Collection-group read access for opted-in collaboration availability (zero PII fields)
    match /{path=**}/availability/{docId} {
      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        (isEmailVerified() && request.auth.token.email == 'sanjaykumarbjc@gmail.com') ||
        (
          isVerifiedStudent()
          && resource.data.isOptedIn == true
        )
      );
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isVerifiedStudent() && (
        existing().status == 'published' ||
        existing().creatorUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedStudent() && (
        resource.data.status == 'published' ||
        resource.data.creatorUid == request.auth.uid ||
        (isEmailVerified() && request.auth.token.email == 'sanjaykumarbjc@gmail.com')
      );
      allow create: if isValidId(projectId)
        && isVerifiedStudent()
        && isValidCampusProject(incoming())
        && incoming().creatorUid == request.auth.uid
        && incoming().likesCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId)
        && isVerifiedStudent()
        && isValidCampusProject(incoming())
        && incoming().creatorUid == existing().creatorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().creatorUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'tagline',
              'description',
              'category',
              'coverImage',
              'tags',
              'teamMembers',
              'status',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(projectId) && (
        isAdmin() || (isVerifiedStudent() && existing().creatorUid == request.auth.uid)
      );
    }

    match /communityPosts/{postId} {
      allow get: if isValidId(postId) && isVerifiedStudent() && (
        existing().status == 'published' ||
        existing().authorUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedStudent() && (
        resource.data.status == 'published' ||
        resource.data.authorUid == request.auth.uid ||
        (isEmailVerified() && request.auth.token.email == 'sanjaykumarbjc@gmail.com')
      );
      allow create: if isValidId(postId)
        && isVerifiedStudent()
        && isValidCommunityPost(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().status == 'published'
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(postId)
        && isVerifiedStudent()
        && isValidCommunityPost(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().authorUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'hashtags', 'category', 'status', 'updatedAt'])
          ) ||
          (
            existing().status == 'published'
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (
              (
                incoming().likesCount == existing().likesCount + 1 &&
                existsAfter(/databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid)) &&
                !exists(/databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid))
              ) ||
              (
                incoming().likesCount == existing().likesCount - 1 &&
                !existsAfter(/databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid)) &&
                exists(/databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid))
              )
            )
          ) ||
          (
            existing().status == 'published'
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && incoming().commentsCount == existing().commentsCount + 1
          )
        );
      allow delete: if isValidId(postId) && (
        isAdmin() || (isVerifiedStudent() && existing().authorUid == request.auth.uid)
      );

      match /likes/{uid} {
        allow get: if isValidId(postId) && isValidId(uid) && isVerifiedStudent();
        allow list: if isValidId(postId) && isVerifiedStudent() && resource.data.uid == request.auth.uid;
        allow create: if isValidId(postId)
          && isValidId(uid)
          && isOwner(uid)
          && isVerifiedStudent()
          && incoming().keys().hasAll(['uid', 'createdAt'])
          && incoming().keys().hasOnly(['uid', 'createdAt'])
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/communityPosts/$(postId));
        allow delete: if isValidId(postId)
          && isValidId(uid)
          && isOwner(uid)
          && isVerifiedStudent();
      }

      match /comments/{commentId} {
        allow get, list: if isValidId(postId) && isVerifiedStudent() &&
          get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published';
        allow create: if isValidId(postId)
          && isValidId(commentId)
          && isVerifiedStudent()
          && isValidPostComment(incoming())
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published';
        allow delete: if isValidId(postId) && isValidId(commentId) && (
          isAdmin() || (isVerifiedStudent() && existing().authorUid == request.auth.uid)
        );
      }
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId) && isVerifiedStudent() && (
        existing().status == 'published' || isAdmin()
      );
      allow list: if isVerifiedStudent() && (
        resource.data.status == 'published' ||
        (isEmailVerified() && request.auth.token.email == 'sanjaykumarbjc@gmail.com')
      );
      allow create: if isValidId(eventId) && isAdmin() && isValidCampusEvent(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(eventId) && isAdmin() && isValidCampusEvent(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(eventId) && isAdmin();
    }

    match /leaderboard/{uid} {
      allow get: if isValidId(uid) && isVerifiedStudent() && (
        existing().status == 'active' || isOwner(uid) || isAdmin()
      );
      allow list: if isVerifiedStudent() && (
        resource.data.status == 'active' ||
        resource.data.uid == request.auth.uid ||
        (isEmailVerified() && request.auth.token.email == 'sanjaykumarbjc@gmail.com')
      );
      // Strictly coordinator/admin-controlled points: students can NEVER modify their own points
      allow create, update: if isValidId(uid) && isAdmin() && isValidLeaderboardEntry(incoming(), uid);
      allow delete: if isValidId(uid) && isAdmin();
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list, write: if false;
    }
  }
}
