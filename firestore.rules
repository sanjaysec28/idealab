rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEmail(email) {
      return email is string
        && email.size() >= 5
        && email.size() <= 160
        && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isVerifiedStudent() {
      return isEmailVerified() && isValidEmail(request.auth.token.email);
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'sanjaykumarbjc@gmail.com'
      );
    }

    function isListAdminClaim() {
      return isEmailVerified() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'sanjaykumarbjc@gmail.com'
      );
    }

    function isOptionalBoundedString(data, field, minLen, maxLen) {
      return !(field in data) || (
        data[field] is string
        && data[field].size() >= minLen
        && data[field].size() <= maxLen
      );
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isOptionalPhoneNumber(data, field) {
      return !(field in data) || (
        data[field] is string
        && data[field].size() <= 32
        && (data[field].size() == 0 || data[field].matches('^[0-9+\\-\\s()]{7,24}$'))
      );
    }

    function isOptionalStringList(data, field, maxItems, maxItemLen) {
      return !(field in data) || (
        data[field] is list
        && data[field].size() <= maxItems
        && (
          data[field].size() == 0 || (
            data[field][0] is string
            && data[field][0].size() >= 1
            && data[field][0].size() <= maxItemLen
          )
        )
      );
    }

    function isOptionalSocialLinks(data) {
      return !('socialLinks' in data) || (
        data.socialLinks is map
        && data.socialLinks.keys().hasOnly(['linkedin', 'github', 'portfolio'])
        && isOptionalBoundedString(data.socialLinks, 'linkedin', 0, 300)
        && isOptionalBoundedString(data.socialLinks, 'github', 0, 300)
        && isOptionalBoundedString(data.socialLinks, 'portfolio', 0, 300)
      );
    }

    function isValidRegNoString(regNo) {
      return regNo is string
        && regNo.size() >= 4
        && regNo.size() <= 32
        && regNo.matches('^[A-Z0-9\\-]+$');
    }

    function isValidStudentFields(data, uid) {
      return data.uid is string
        && data.uid == uid
        && isValidId(data.uid)
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 100
        && isValidEmail(data.email)
        && data.createdAt is timestamp
        && (!('authProvider' in data) || data.authProvider in ['google', 'password'])
        && (!('registrationNumber' in data) || (
          data.registrationNumber is string
          && data.registrationNumber.size() >= 4
          && data.registrationNumber.size() <= 32
          && data.registrationNumber.matches('^[A-Za-z0-9\\-]+$')
        ))
        && isOptionalBoundedString(data, 'department', 2, 80)
        && isOptionalBoundedString(data, 'degree', 2, 40)
        && isOptionalBoundedString(data, 'academicYear', 2, 24)
        && isOptionalBoundedString(data, 'currentAcademicYear', 2, 24)
        && isOptionalBoundedString(data, 'currentSemester', 1, 24)
        && isOptionalBoundedString(data, 'photoURL', 0, 1000)
        && isOptionalBoundedString(data, 'avatarPresetId', 0, 64)
        && isOptionalBoundedString(data, 'bannerURL', 0, 1000)
        && isOptionalBoundedString(data, 'bannerPresetId', 0, 64)
        && isOptionalBoundedString(data, 'bio', 0, 600)
        && isOptionalBoundedString(data, 'location', 0, 120)
        && isOptionalPhoneNumber(data, 'phoneNumber')
        && isOptionalPhoneNumber(data, 'whatsappNumber')
        && isOptionalStringList(data, 'skills', 25, 60)
        && isOptionalStringList(data, 'interests', 25, 60)
        && isOptionalSocialLinks(data)
        && isOptionalBool(data, 'timetableCompleted')
        && isOptionalBool(data, 'profileSetupCompleted')
        && isOptionalBool(data, 'timetableLocked')
        && (!('timetableStatus' in data) || data.timetableStatus in ['not_submitted', 'submitted'])
        && (!('timetableWorkflowState' in data) || data.timetableWorkflowState in ['not_started', 'in_review', 'finalized'])
        && (!('timetableAttemptsUsed' in data) || data.timetableAttemptsUsed == null || (data.timetableAttemptsUsed is int && data.timetableAttemptsUsed >= 0 && data.timetableAttemptsUsed <= 1))
        && (!('timetableWarningAcceptedAt' in data) || data.timetableWarningAcceptedAt == null || data.timetableWarningAcceptedAt is timestamp)
        && (!('timetableFinalizedAt' in data) || data.timetableFinalizedAt == null || data.timetableFinalizedAt is timestamp)
        && (!('timetableLastModifiedBy' in data) || data.timetableLastModifiedBy == null || (data.timetableLastModifiedBy is string && data.timetableLastModifiedBy.size() >= 1 && data.timetableLastModifiedBy.size() <= 128))
        && (!('timetableUpdatedAt' in data) || data.timetableUpdatedAt == null || data.timetableUpdatedAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function hasValidRegNoReservationAfter(regNo, uid) {
      return isValidRegNoString(regNo)
        && existsAfter(/databases/$(database)/documents/registrationNumbers/$(regNo))
        && getAfter(/databases/$(database)/documents/registrationNumbers/$(regNo)).data.uid == uid;
    }

    function isValidLiveStudentCreate(data, uid) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt'])
        && data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'authProvider',
          'registrationNumber',
          'department',
          'degree',
          'academicYear',
          'currentAcademicYear',
          'currentSemester',
          'photoURL',
          'avatarPresetId',
          'bannerURL',
          'bannerPresetId',
          'bio',
          'location',
          'phoneNumber',
          'whatsappNumber',
          'skills',
          'interests',
          'socialLinks',
          'profileSetupCompleted',
          'timetableWorkflowState',
          'timetableAttemptsUsed',
          'timetableWarningAcceptedAt',
          'timetableLocked',
          'timetableFinalizedAt',
          'timetableLastModifiedBy',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidStudentFields(data, uid)
        && data.uid == request.auth.uid
        && data.email.lower() == request.auth.token.email.lower()
        && data.createdAt == request.time
        && (!('updatedAt' in data) || data.updatedAt == request.time)
        && (!('timetableUpdatedAt' in data) || data.timetableUpdatedAt == request.time)
        && (!('timetableAttemptsUsed' in data) || data.timetableAttemptsUsed == 0)
        && (!('timetableLocked' in data) || data.timetableLocked == false)
        && (!('timetableWorkflowState' in data) || data.timetableWorkflowState == 'not_started')
        && (!('timetableCompleted' in data) || data.timetableCompleted == false)
        && !('timetableWarningAcceptedAt' in data)
        && !('timetableFinalizedAt' in data)
        && (!('registrationNumber' in data) || hasValidRegNoReservationAfter(data.registrationNumber, uid));
    }

    function isStudentTimetableCurrentlyLocked(prev) {
      return ('timetableLocked' in prev && prev.timetableLocked == true)
        || ('timetableWorkflowState' in prev && prev.timetableWorkflowState == 'finalized');
    }

    function isValidStudentAttemptsTransition(data, prev) {
      return ('timetableAttemptsUsed' in prev && prev.timetableAttemptsUsed is int && prev.timetableAttemptsUsed >= 1)
        ? (data.timetableAttemptsUsed == prev.timetableAttemptsUsed)
        : (!('timetableAttemptsUsed' in data) || data.timetableAttemptsUsed == null || data.timetableAttemptsUsed in [0, 1]);
    }

    function isValidStudentWorkflowTransition(data, prev) {
      return !('timetableWorkflowState' in prev)
        ? (!('timetableWorkflowState' in data) || data.timetableWorkflowState in ['not_started', 'in_review'])
        : (
          prev.timetableWorkflowState == 'finalized'
            ? data.timetableWorkflowState == 'finalized'
            : (
              prev.timetableWorkflowState == 'in_review'
                ? data.timetableWorkflowState in ['in_review', 'finalized']
                : data.timetableWorkflowState in ['not_started', 'in_review']
            )
        );
    }

    function isValidLiveStudentSelfUpdate(data, prev, uid) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt'])
        && data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'authProvider',
          'registrationNumber',
          'department',
          'degree',
          'academicYear',
          'currentAcademicYear',
          'currentSemester',
          'photoURL',
          'avatarPresetId',
          'bannerURL',
          'bannerPresetId',
          'bio',
          'location',
          'phoneNumber',
          'whatsappNumber',
          'skills',
          'interests',
          'socialLinks',
          'profileSetupCompleted',
          'timetableWorkflowState',
          'timetableAttemptsUsed',
          'timetableWarningAcceptedAt',
          'timetableLocked',
          'timetableFinalizedAt',
          'timetableLastModifiedBy',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt',
          'membershipStatus',
          'approvedAt',
          'approvedBy',
          'rejectionReason',
          'createdAt',
          'updatedAt'
        ])
        && isValidStudentFields(data, uid)
        && data.uid == prev.uid
        && data.email == prev.email
        && data.createdAt == prev.createdAt
        && (
          ('registrationNumber' in prev && data.registrationNumber == prev.registrationNumber) ||
          (!('registrationNumber' in prev) && (!('registrationNumber' in data) || hasValidRegNoReservationAfter(data.registrationNumber, uid)))
        )
        && (!('profileSetupCompleted' in prev && prev.profileSetupCompleted == true) || data.profileSetupCompleted == true)
        && (!('timetableLocked' in prev && prev.timetableLocked == true) || data.timetableLocked == true)
        && (!('timetableWarningAcceptedAt' in prev) || prev.timetableWarningAcceptedAt == null || data.timetableWarningAcceptedAt == prev.timetableWarningAcceptedAt)
        && (!('timetableFinalizedAt' in prev) || prev.timetableFinalizedAt == null || data.timetableFinalizedAt == prev.timetableFinalizedAt)
        && (!('timetableFinalizedAt' in data) || data.timetableFinalizedAt == null || (('timetableFinalizedAt' in prev) && prev.timetableFinalizedAt != null) || (
          data.timetableFinalizedAt == request.time &&
          data.timetableLocked == true &&
          data.timetableWorkflowState == 'finalized'
        ))
        && isValidStudentAttemptsTransition(data, prev)
        && isValidStudentWorkflowTransition(data, prev)
        && (!isStudentTimetableCurrentlyLocked(prev) || !data.diff(prev).affectedKeys().hasAny([
          'timetableWorkflowState',
          'timetableAttemptsUsed',
          'timetableWarningAcceptedAt',
          'timetableLocked',
          'timetableFinalizedAt',
          'timetableLastModifiedBy',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt'
        ]))
        && data.updatedAt == request.time
        && (!('timetableUpdatedAt' in data) || data.timetableUpdatedAt == null || data.timetableUpdatedAt == request.time || (('timetableUpdatedAt' in prev) && data.timetableUpdatedAt == prev.timetableUpdatedAt))
        && data.diff(prev).affectedKeys().hasOnly([
          'fullName',
          'authProvider',
          'registrationNumber',
          'department',
          'degree',
          'academicYear',
          'currentAcademicYear',
          'currentSemester',
          'photoURL',
          'avatarPresetId',
          'bannerURL',
          'bannerPresetId',
          'bio',
          'location',
          'phoneNumber',
          'whatsappNumber',
          'skills',
          'interests',
          'socialLinks',
          'profileSetupCompleted',
          'timetableWorkflowState',
          'timetableAttemptsUsed',
          'timetableLocked',
          'timetableFinalizedAt',
          'timetableLastModifiedBy',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt',
          'updatedAt'
        ]);
    }

    function isValidStudentWarningAckUpdate(data, prev, uid) {
      return isOwner(uid)
        && isVerifiedStudent()
        && (!('uid' in prev) || prev.uid == uid)
        && ('profileSetupCompleted' in prev && prev.profileSetupCompleted == true)
        && !isStudentTimetableCurrentlyLocked(prev)
        && (!('timetableWarningAcceptedAt' in prev) || prev.timetableWarningAcceptedAt == null)
        && data.diff(prev).affectedKeys().hasOnly(['timetableWarningAcceptedAt', 'updatedAt'])
        && data.diff(prev).affectedKeys().hasAll(['timetableWarningAcceptedAt', 'updatedAt'])
        && data.timetableWarningAcceptedAt is timestamp
        && data.timetableWarningAcceptedAt == request.time
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/timetableAuditLogs/$('warn_' + uid));
    }

    function isValidStudentTimetableStateUpdate(data, prev, uid) {
      return isOwner(uid)
        && isVerifiedStudent()
        && (!('uid' in prev) || prev.uid == uid)
        && ('profileSetupCompleted' in prev && prev.profileSetupCompleted == true)
        && ('timetableWarningAcceptedAt' in prev && prev.timetableWarningAcceptedAt is timestamp)
        && !isStudentTimetableCurrentlyLocked(prev)
        && data.diff(prev).affectedKeys().hasOnly([
          'department',
          'academicYear',
          'currentAcademicYear',
          'currentSemester',
          'timetableWorkflowState',
          'timetableAttemptsUsed',
          'timetableLocked',
          'timetableFinalizedAt',
          'timetableLastModifiedBy',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt',
          'updatedAt'
        ])
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 80
        && data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 24
        && data.currentAcademicYear is string && data.currentAcademicYear.size() >= 2 && data.currentAcademicYear.size() <= 24
        && data.currentSemester is string && data.currentSemester.size() >= 1 && data.currentSemester.size() <= 24
        && data.timetableLastModifiedBy == uid
        && data.timetableUpdatedAt == request.time
        && data.updatedAt == request.time
        && (
          (
            (!('timetableAttemptsUsed' in prev) || prev.timetableAttemptsUsed == null || prev.timetableAttemptsUsed == 0)
            && !data.diff(prev).affectedKeys().hasAny(['timetableFinalizedAt', 'timetableCompleted', 'timetableStatus'])
            && data.timetableWorkflowState == 'in_review'
            && data.timetableAttemptsUsed == 1
            && data.timetableLocked == false
            && getAfter(/databases/$(database)/documents/students/$(uid)/timetable/current).data.submissionStatus == 'in_review'
            && getAfter(/databases/$(database)/documents/students/$(uid)/timetable/current).data.isLocked == false
            && getAfter(/databases/$(database)/documents/students/$(uid)/timetable/current).data.attemptNumber == 1
          ) || (
            ('timetableAttemptsUsed' in prev && prev.timetableAttemptsUsed == 1)
            && ('timetableWorkflowState' in prev && prev.timetableWorkflowState == 'in_review')
            && !data.diff(prev).affectedKeys().hasAny([
              'timetableAttemptsUsed',
              'timetableLocked',
              'timetableFinalizedAt',
              'timetableCompleted',
              'timetableStatus'
            ])
            && data.timetableWorkflowState == 'in_review'
            && getAfter(/databases/$(database)/documents/students/$(uid)/timetable/current).data.submissionStatus == 'in_review'
            && getAfter(/databases/$(database)/documents/students/$(uid)/timetable/current).data.isLocked == false
          ) || (
            !('timetableFinalizedAt' in prev && prev.timetableFinalizedAt != null)
            && exists(/databases/$(database)/documents/students/$(uid)/timetable/current)
            && data.timetableWorkflowState == 'finalized'
            && data.timetableAttemptsUsed == 1
            && data.timetableLocked == true
            && data.timetableFinalizedAt == request.time
            && data.timetableCompleted == true
            && data.timetableStatus == 'submitted'
            && getAfter(/databases/$(database)/documents/students/$(uid)/timetable/current).data.submissionStatus == 'finalized'
            && getAfter(/databases/$(database)/documents/students/$(uid)/timetable/current).data.isLocked == true
          )
        );
    }

    function isValidAdminStudentUpdate(data, prev, uid) {
      return isValidStudentFields(data, uid)
        && data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'authProvider',
          'registrationNumber',
          'department',
          'degree',
          'academicYear',
          'currentAcademicYear',
          'currentSemester',
          'photoURL',
          'avatarPresetId',
          'bannerURL',
          'bannerPresetId',
          'bio',
          'location',
          'phoneNumber',
          'whatsappNumber',
          'skills',
          'interests',
          'socialLinks',
          'profileSetupCompleted',
          'timetableWorkflowState',
          'timetableAttemptsUsed',
          'timetableWarningAcceptedAt',
          'timetableLocked',
          'timetableFinalizedAt',
          'timetableLastModifiedBy',
          'timetableCompleted',
          'timetableStatus',
          'timetableUpdatedAt',
          'membershipStatus',
          'approvedAt',
          'approvedBy',
          'rejectionReason',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == prev.uid
        && data.email == prev.email
        && data.createdAt == prev.createdAt;
    }

    // Optional weekday-to-slot map used by the timetable UI.
    // Only known weekdays and supported slot IDs are accepted.
    function isValidScheduleDaySlots(schedule, day) {
      return !(day in schedule) || (
        schedule[day] is list
        && schedule[day].size() <= 4
        && schedule[day].hasOnly(['slot-1', 'slot-2', 'slot-3', 'slot-4'])
      );
    }

    function isValidScheduleByDay(data) {
      return !('scheduleByDay' in data) || (
        data.scheduleByDay is map
        && data.scheduleByDay.keys().hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && isValidScheduleDaySlots(data.scheduleByDay, 'mon')
        && isValidScheduleDaySlots(data.scheduleByDay, 'tue')
        && isValidScheduleDaySlots(data.scheduleByDay, 'wed')
        && isValidScheduleDaySlots(data.scheduleByDay, 'thu')
        && isValidScheduleDaySlots(data.scheduleByDay, 'fri')
        && isValidScheduleDaySlots(data.scheduleByDay, 'sat')
      );
    }

    function isValidTimetableWrite(data, uid) {
      return data.keys().hasAll([
          'uid',
          'semester',
          'academicYear',
          'department',
          'classes',
          'selectedWeekdays',
          'selectedTimeSlots',
          'subjectCodes',
          'subjectNames',
          'facultyNames',
          'totalSubjects',
          'classDays',
          'totalClasses',
          'submissionStatus',
          'isLocked',
          'attemptNumber',
          'version',
          'createdAt',
          'updatedAt',
          'lastEditedByUid',
          'lastEditedByRole'
        ])
        && data.keys().hasOnly([
          'uid',
          'semester',
          'academicYear',
          'department',
          'classes',
          'scheduleByDay',
          'selectedWeekdays',
          'selectedTimeSlots',
          'subjectCodes',
          'subjectNames',
          'facultyNames',
          'totalSubjects',
          'classDays',
          'totalClasses',
          'submissionStatus',
          'isLocked',
          'attemptNumber',
          'version',
          'createdAt',
          'submittedAt',
          'finalizedAt',
          'updatedAt',
          'lastEditedByUid',
          'lastEditedByRole'
        ])
        && data.uid == uid
        && isValidScheduleByDay(data)
        && data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 24
        && data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 24
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 80
        && data.classes is list && data.classes.size() >= 1 && data.classes.size() <= 24 && data.classes[0] is map
        && data.selectedWeekdays is list && data.selectedWeekdays.size() >= 1 && data.selectedWeekdays.size() <= 6 && data.selectedWeekdays.hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat'])
        && data.selectedTimeSlots is list && data.selectedTimeSlots.size() >= 1 && data.selectedTimeSlots.size() <= 4 && data.selectedTimeSlots.hasOnly(['slot-1', 'slot-2', 'slot-3', 'slot-4'])
        && data.subjectCodes is list && data.subjectCodes.size() >= 1 && data.subjectCodes.size() <= 24 && data.subjectCodes[0] is string
        && data.subjectNames is list && data.subjectNames.size() >= 1 && data.subjectNames.size() <= 24 && data.subjectNames[0] is string
        && data.facultyNames is list && data.facultyNames.size() >= 1 && data.facultyNames.size() <= 24 && data.facultyNames[0] is string
        && data.totalSubjects is int && data.totalSubjects >= 1 && data.totalSubjects <= 24
        && data.classDays is int && data.classDays >= 1 && data.classDays <= 6
        && data.totalClasses is int && data.totalClasses >= 1 && data.totalClasses <= 24
        && data.submissionStatus in ['in_review', 'finalized', 'submitted']
        && data.isLocked is bool
        && data.attemptNumber is int && data.attemptNumber == 1
        && data.version is int && data.version >= 1 && data.version <= 1000
        && data.createdAt is timestamp
        && (!('submittedAt' in data) || data.submittedAt is timestamp)
        && (!('finalizedAt' in data) || data.finalizedAt is timestamp)
        && data.updatedAt == request.time
        && isValidId(data.lastEditedByUid)
        && data.lastEditedByRole in ['student', 'admin'];
    }

    function isValidAvailabilityWrite(data, uid) {
      return data.keys().hasAll([
          'uid',
          'freeSlots',
          'totalFreePeriods',
          'totalOccupiedPeriods',
          'utilizationPercentage',
          'isOptedIn',
          'hasSubmittedTimetable',
          'timetableVersion',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'freeSlots',
          'totalFreePeriods',
          'totalOccupiedPeriods',
          'utilizationPercentage',
          'isOptedIn',
          'hasSubmittedTimetable',
          'timetableVersion',
          'fullName',
          'department',
          'degree',
          'academicYear',
          'photoURL',
          'avatarPresetId',
          'skills',
          'emailVerified',
          'profileComplete',
          'phoneNumber',
          'whatsappNumber',
          'updatedAt'
        ])
        && data.uid == uid
        && data.freeSlots is list && data.freeSlots.size() <= 24 && (data.freeSlots.size() == 0 || data.freeSlots[0] is map)
        && data.totalFreePeriods is int && data.totalFreePeriods >= 0 && data.totalFreePeriods <= 24
        && data.totalOccupiedPeriods is int && data.totalOccupiedPeriods >= 0 && data.totalOccupiedPeriods <= 24
        && (data.totalFreePeriods + data.totalOccupiedPeriods) == 24
        && data.utilizationPercentage is int && data.utilizationPercentage >= 0 && data.utilizationPercentage <= 100
        && data.isOptedIn is bool
        && data.hasSubmittedTimetable is bool
        && (!data.isOptedIn || (data.hasSubmittedTimetable == true && data.totalFreePeriods > 0))
        && data.timetableVersion is int && data.timetableVersion >= 1 && data.timetableVersion <= 1000
        && isOptionalBoundedString(data, 'fullName', 2, 100)
        && isOptionalBoundedString(data, 'department', 2, 80)
        && isOptionalBoundedString(data, 'degree', 2, 40)
        && isOptionalBoundedString(data, 'academicYear', 2, 24)
        && isOptionalBoundedString(data, 'photoURL', 0, 1000)
        && isOptionalBoundedString(data, 'avatarPresetId', 0, 64)
        && isOptionalStringList(data, 'skills', 25, 60)
        && isOptionalBool(data, 'emailVerified')
        && isOptionalBool(data, 'profileComplete')
        && isOptionalPhoneNumber(data, 'phoneNumber')
        && isOptionalPhoneNumber(data, 'whatsappNumber')
        && data.updatedAt == request.time;
    }

    function isValidCampusProject(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'category',
          'creatorUid',
          'creatorName',
          'likesCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'tagline',
          'description',
          'category',
          'coverImage',
          'tags',
          'creatorUid',
          'creatorName',
          'creatorAvatar',
          'teamMembers',
          'likesCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && isOptionalBoundedString(data, 'tagline', 0, 200)
        && data.description is string && data.description.size() >= 4 && data.description.size() <= 2000
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 40
        && isOptionalBoundedString(data, 'coverImage', 0, 1000)
        && isOptionalStringList(data, 'tags', 12, 40)
        && data.creatorUid is string && isValidId(data.creatorUid)
        && data.creatorName is string && data.creatorName.size() >= 2 && data.creatorName.size() <= 100
        && isOptionalBoundedString(data, 'creatorAvatar', 0, 1000)
        && (!('teamMembers' in data) || (
          data.teamMembers is list
          && data.teamMembers.size() <= 10
          && (data.teamMembers.size() == 0 || data.teamMembers[0] is map)
        ))
        && data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000
        && data.status in ['draft', 'published', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll([
          'authorUid',
          'authorName',
          'category',
          'content',
          'likesCount',
          'commentsCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorUid',
          'authorName',
          'authorDepartment',
          'authorYear',
          'authorAvatar',
          'authorAvatarPresetId',
          'category',
          'content',
          'hashtags',
          'likesCount',
          'commentsCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.authorUid is string && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && isOptionalBoundedString(data, 'authorDepartment', 0, 80)
        && isOptionalBoundedString(data, 'authorYear', 0, 24)
        && isOptionalBoundedString(data, 'authorAvatar', 0, 1000)
        && isOptionalBoundedString(data, 'authorAvatarPresetId', 0, 64)
        && data.category in ['Projects', 'Ideas', 'Team Up', 'Updates']
        && data.content is string && data.content.size() >= 2 && data.content.size() <= 1200
        && isOptionalStringList(data, 'hashtags', 8, 40)
        && data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000
        && data.commentsCount is int && data.commentsCount >= 0 && data.commentsCount <= 1000000
        && data.status in ['published', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPostComment(data) {
      return data.keys().hasAll(['authorUid', 'authorName', 'content', 'createdAt'])
        && data.keys().hasOnly(['authorUid', 'authorName', 'authorAvatar', 'content', 'createdAt'])
        && data.authorUid == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && isOptionalBoundedString(data, 'authorAvatar', 0, 1000)
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 500
        && data.createdAt == request.time;
    }

    function isValidCampusEvent(data) {
      return data.keys().hasAll(['title', 'eventDate', 'timeRange', 'location', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'title',
          'description',
          'eventDate',
          'timeRange',
          'location',
          'category',
          'thumbnail',
          'capacity',
          'registeredCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && isOptionalBoundedString(data, 'description', 0, 2000)
        && data.eventDate is timestamp
        && data.timeRange is string && data.timeRange.size() >= 2 && data.timeRange.size() <= 60
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 140
        && isOptionalBoundedString(data, 'category', 2, 40)
        && isOptionalBoundedString(data, 'thumbnail', 0, 1000)
        && (!('capacity' in data) || (data.capacity is int && data.capacity >= 1 && data.capacity <= 10000))
        && (!('registeredCount' in data) || (data.registeredCount is int && data.registeredCount >= 0 && data.registeredCount <= 10000))
        && data.status in ['draft', 'published', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, uid) {
      return data.keys().hasAll(['uid', 'fullName', 'department', 'approvedPoints', 'status', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'fullName',
          'department',
          'academicYear',
          'photoURL',
          'avatarPresetId',
          'approvedPoints',
          'projectsCompleted',
          'badge',
          'status',
          'awardedBy',
          'updatedAt'
        ])
        && data.uid == uid
        && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 80
        && isOptionalBoundedString(data, 'academicYear', 0, 24)
        && isOptionalBoundedString(data, 'photoURL', 0, 1000)
        && isOptionalBoundedString(data, 'avatarPresetId', 0, 64)
        && data.approvedPoints is int && data.approvedPoints >= 0 && data.approvedPoints <= 1000000
        && (!('projectsCompleted' in data) || (data.projectsCompleted is int && data.projectsCompleted >= 0 && data.projectsCompleted <= 1000))
        && isOptionalBoundedString(data, 'badge', 0, 60)
        && data.status in ['active', 'hidden']
        && isOptionalBoundedString(data, 'awardedBy', 1, 128)
        && data.updatedAt == request.time;
    }

    function isValidTimetableAuditLog(data) {
      return data.keys().hasAll(['studentUid', 'action', 'actorUid', 'actorRole', 'timestamp'])
        && data.keys().hasOnly([
          'studentUid',
          'studentEmail',
          'studentName',
          'registrationNumber',
          'action',
          'actorUid',
          'actorEmail',
          'actorRole',
          'reason',
          'previousClasses',
          'newClasses',
          'previousVersion',
          'newVersion',
          'timestamp'
        ])
        && isValidId(data.studentUid)
        && isValidId(data.actorUid)
        && isOptionalBoundedString(data, 'studentEmail', 5, 160)
        && isOptionalBoundedString(data, 'studentName', 1, 100)
        && isOptionalBoundedString(data, 'registrationNumber', 4, 32)
        && isOptionalBoundedString(data, 'actorEmail', 5, 160)
        && isOptionalBoundedString(data, 'reason', 0, 500)
        && (!('previousClasses' in data) || (data.previousClasses is list && data.previousClasses.size() <= 24))
        && (!('newClasses' in data) || (data.newClasses is list && data.newClasses.size() <= 24))
        && (!('previousVersion' in data) || (data.previousVersion is int && data.previousVersion >= 0 && data.previousVersion <= 1000))
        && (!('newVersion' in data) || (data.newVersion is int && data.newVersion >= 0 && data.newVersion <= 1000))
        && data.timestamp == request.time;
    }

    // Global uniqueness reservation for college registration numbers
    match /registrationNumbers/{regNo} {
      allow get: if isValidId(regNo) && isVerifiedStudent();
      allow list: if isListAdminClaim();
      allow create: if isValidId(regNo)
        && isValidRegNoString(regNo)
        && isVerifiedStudent()
        && incoming().keys().hasAll(['uid', 'createdAt'])
        && incoming().keys().hasOnly(['uid', 'createdAt'])
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/registrationNumbers/$(regNo));
      allow update, delete: if isValidId(regNo) && isAdmin();
    }

    match /students/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());

      // Never use exists()/get() in list queries
      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isListAdminClaim()
      );

      allow create: if isValidId(uid)
        && isOwner(uid)
        && isVerifiedStudent()
        && isValidLiveStudentCreate(incoming(), uid);

      allow update: if isValidId(uid) && resource != null && (
        isValidStudentWarningAckUpdate(incoming(), existing(), uid) ||
        isValidStudentTimetableStateUpdate(incoming(), existing(), uid) ||
        (isAdmin() && isValidAdminStudentUpdate(incoming(), existing(), uid)) ||
        (isOwner(uid) && isVerifiedStudent() && isValidLiveStudentSelfUpdate(incoming(), existing(), uid))
      );

      allow delete: if isValidId(uid) && isAdmin();

      match /timetable/{docId} {
        allow get: if isValidId(uid) && docId == 'current' && (isOwner(uid) || isAdmin());
        allow list: if isValidId(uid) && docId == 'current' && isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          isListAdminClaim()
        );

        allow create: if isValidId(uid) && docId == 'current' && (
          (
            isAdmin()
            && isValidTimetableWrite(incoming(), uid)
            && incoming().submissionStatus == 'finalized'
            && incoming().isLocked == true
            && incoming().lastEditedByUid == request.auth.uid
            && incoming().lastEditedByRole == 'admin'
          ) || (
            isOwner(uid)
            && isVerifiedStudent()
            && isValidTimetableWrite(incoming(), uid)
            && incoming().submissionStatus == 'in_review'
            && incoming().isLocked == false
            && incoming().attemptNumber == 1
            && incoming().version == 1
            && incoming().createdAt == request.time
            && incoming().lastEditedByUid == request.auth.uid
            && incoming().lastEditedByRole == 'student'
            && get(/databases/$(database)/documents/students/$(uid)).data.profileSetupCompleted == true
            && !isStudentTimetableCurrentlyLocked(get(/databases/$(database)/documents/students/$(uid)).data)
            && ('timetableWarningAcceptedAt' in get(/databases/$(database)/documents/students/$(uid)).data)
            && get(/databases/$(database)/documents/students/$(uid)).data.timetableWarningAcceptedAt is timestamp
            && (!('timetableAttemptsUsed' in get(/databases/$(database)/documents/students/$(uid)).data)
              || get(/databases/$(database)/documents/students/$(uid)).data.timetableAttemptsUsed == null
              || get(/databases/$(database)/documents/students/$(uid)).data.timetableAttemptsUsed == 0)
            && getAfter(/databases/$(database)/documents/students/$(uid)).data.timetableAttemptsUsed == 1
            && getAfter(/databases/$(database)/documents/students/$(uid)).data.timetableWorkflowState == 'in_review'
          )
        );

        allow update: if isValidId(uid) && docId == 'current' && (
          (
            isAdmin()
            && isValidTimetableWrite(incoming(), uid)
            && incoming().uid == existing().uid
            && incoming().submissionStatus == 'finalized'
            && incoming().isLocked == true
            && incoming().lastEditedByUid == request.auth.uid
            && incoming().lastEditedByRole == 'admin'
          ) || (
            isOwner(uid)
            && isVerifiedStudent()
            && !isStudentTimetableCurrentlyLocked(get(/databases/$(database)/documents/students/$(uid)).data)
            && (!('isLocked' in existing()) || existing().isLocked == false)
            && existing().submissionStatus == 'in_review'
            && isValidTimetableWrite(incoming(), uid)
            && incoming().uid == existing().uid
            && (!('attemptNumber' in existing()) || existing().attemptNumber == null ? incoming().attemptNumber == 1 : incoming().attemptNumber == existing().attemptNumber)
            && (!('createdAt' in existing()) || existing().createdAt == null ? incoming().createdAt is timestamp : incoming().createdAt == existing().createdAt)
            && (!('version' in existing()) || existing().version == null ? incoming().version >= 1 : incoming().version >= existing().version)
            && incoming().lastEditedByUid == request.auth.uid
            && incoming().lastEditedByRole == 'student'
            && (
              (
                incoming().submissionStatus == 'in_review' &&
                incoming().isLocked == false
              ) || (
                incoming().submissionStatus == 'finalized' &&
                incoming().isLocked == true &&
                incoming().finalizedAt == request.time &&
                getAfter(/databases/$(database)/documents/students/$(uid)).data.timetableLocked == true &&
                getAfter(/databases/$(database)/documents/students/$(uid)).data.timetableWorkflowState == 'finalized'
              )
            )
          )
        );

        allow delete: if isValidId(uid) && isAdmin();
      }

      match /availability/{docId} {
        allow get: if isValidId(uid) && docId == 'current' && (
          isOwner(uid) ||
          isAdmin() ||
          (
            isVerifiedStudent()
            && existing().isOptedIn == true
            && existing().hasSubmittedTimetable == true
            && existing().totalFreePeriods > 0
          )
        );

        allow list: if isValidId(uid) && docId == 'current' && isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          isListAdminClaim() ||
          (
            isVerifiedStudent()
            && resource.data.isOptedIn == true
          )
        );

        allow create: if isValidId(uid) && docId == 'current' && (
          (
            isAdmin() && isValidAvailabilityWrite(incoming(), uid)
          ) || (
            isOwner(uid)
            && isVerifiedStudent()
            && isValidAvailabilityWrite(incoming(), uid)
            && getAfter(/databases/$(database)/documents/students/$(uid)).data.timetableWorkflowState in ['in_review', 'finalized']
          )
        );

        allow update: if isValidId(uid) && docId == 'current' && (
          (
            isAdmin() && isValidAvailabilityWrite(incoming(), uid) && incoming().uid == existing().uid
          ) || (
            isOwner(uid)
            && isVerifiedStudent()
            && isValidAvailabilityWrite(incoming(), uid)
            && incoming().uid == existing().uid
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'isOptedIn',
                'fullName',
                'department',
                'degree',
                'academicYear',
                'photoURL',
                'avatarPresetId',
                'skills',
                'emailVerified',
                'profileComplete',
                'phoneNumber',
                'whatsappNumber',
                'updatedAt'
              ]) || (
                get(/databases/$(database)/documents/students/$(uid)).data.timetableLocked != true
                && (!('timetableVersion' in existing()) || incoming().timetableVersion >= existing().timetableVersion)
              )
            )
          )
        );

        allow delete: if isValidId(uid) && isAdmin();
      }
    }

    // Collection-group read access for verified opted-in collaboration availability
    match /{path=**}/availability/{docId} {
      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isListAdminClaim() ||
        (
          isVerifiedStudent()
          && resource.data.isOptedIn == true
        )
      );
    }

    // Immutable timetable audit log records
    match /timetableAuditLogs/{logId} {
      allow get: if isValidId(logId) && isVerifiedStudent() && (
        (resource == null && logId == ('warn_' + request.auth.uid)) ||
        (resource != null && existing().studentUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isVerifiedStudent() && (
        resource.data.studentUid == request.auth.uid || isListAdminClaim()
      );
      allow create: if isValidId(logId) && isValidTimetableAuditLog(incoming()) && (
        (
          isVerifiedStudent()
          && incoming().actorUid == request.auth.uid
          && incoming().studentUid == request.auth.uid
          && incoming().actorRole == 'student'
          && (
            (
              incoming().action == 'warning_acknowledged'
              && logId == ('warn_' + request.auth.uid)
              && getAfter(/databases/$(database)/documents/students/$(request.auth.uid)).data.timetableWarningAcceptedAt == request.time
            ) ||
            incoming().action in [
              'timetable_created',
              'timetable_updated_in_review',
              'timetable_finalized'
            ]
          )
        ) || (
          isAdmin()
          && incoming().actorUid == request.auth.uid
          && incoming().actorRole == 'admin'
          && incoming().action == 'admin_correction'
          && incoming().reason is string
          && incoming().reason.size() >= 5
          && incoming().reason.size() <= 500
        )
      );
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isVerifiedStudent() && (
        existing().status == 'published' ||
        existing().creatorUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedStudent() && (
        resource.data.status == 'published' ||
        resource.data.creatorUid == request.auth.uid ||
        isListAdminClaim()
      );
      allow create: if isValidId(projectId)
        && isVerifiedStudent()
        && isValidCampusProject(incoming())
        && incoming().creatorUid == request.auth.uid
        && incoming().likesCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId)
        && isVerifiedStudent()
        && isValidCampusProject(incoming())
        && incoming().creatorUid == existing().creatorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().creatorUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'tagline',
              'description',
              'category',
              'coverImage',
              'tags',
              'teamMembers',
              'status',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(projectId) && (
        isAdmin() || (isVerifiedStudent() && existing().creatorUid == request.auth.uid)
      );
    }

    match /communityPosts/{postId} {
      allow get: if isValidId(postId) && isVerifiedStudent() && (
        existing().status == 'published' ||
        existing().authorUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedStudent() && (
        resource.data.status == 'published' ||
        resource.data.authorUid == request.auth.uid ||
        isListAdminClaim()
      );
      allow create: if isValidId(postId)
        && isVerifiedStudent()
        && isValidCommunityPost(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().status == 'published'
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(postId)
        && isVerifiedStudent()
        && isValidCommunityPost(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().authorUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'hashtags', 'category', 'status', 'updatedAt'])
          ) ||
          (
            existing().status == 'published'
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (
              (
                incoming().likesCount == existing().likesCount + 1 &&
                existsAfter(/databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid)) &&
                !exists(/databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid))
              ) ||
              (
                incoming().likesCount == existing().likesCount - 1 &&
                !existsAfter(/databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid)) &&
                exists(/databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid))
              )
            )
          ) ||
          (
            existing().status == 'published'
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && incoming().commentsCount == existing().commentsCount + 1
          )
        );
      allow delete: if isValidId(postId) && (
        isAdmin() || (isVerifiedStudent() && existing().authorUid == request.auth.uid)
      );

      match /likes/{uid} {
        allow get: if isValidId(postId) && isValidId(uid) && isVerifiedStudent();
        allow list: if isValidId(postId) && isVerifiedStudent() && resource.data.uid == request.auth.uid;
        allow create: if isValidId(postId)
          && isValidId(uid)
          && isOwner(uid)
          && isVerifiedStudent()
          && incoming().keys().hasAll(['uid', 'createdAt'])
          && incoming().keys().hasOnly(['uid', 'createdAt'])
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/communityPosts/$(postId));
        allow delete: if isValidId(postId)
          && isValidId(uid)
          && isOwner(uid)
          && isVerifiedStudent();
      }

      match /comments/{commentId} {
        allow get, list: if isValidId(postId) && isVerifiedStudent() &&
          get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published';
        allow create: if isValidId(postId)
          && isValidId(commentId)
          && isVerifiedStudent()
          && isValidPostComment(incoming())
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published';
        allow delete: if isValidId(postId) && isValidId(commentId) && (
          isAdmin() || (isVerifiedStudent() && existing().authorUid == request.auth.uid)
        );
      }
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId) && isVerifiedStudent() && (
        existing().status == 'published' || isAdmin()
      );
      allow list: if isVerifiedStudent() && (
        resource.data.status == 'published' ||
        isListAdminClaim()
      );
      allow create: if isValidId(eventId) && isAdmin() && isValidCampusEvent(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(eventId) && isAdmin() && isValidCampusEvent(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(eventId) && isAdmin();
    }

    match /leaderboard/{uid} {
      allow get: if isValidId(uid) && isVerifiedStudent() && (
        existing().status == 'active' || isOwner(uid) || isAdmin()
      );
      allow list: if isVerifiedStudent() && (
        resource.data.status == 'active' ||
        resource.data.uid == request.auth.uid ||
        isListAdminClaim()
      );
      // Strictly coordinator/admin-controlled points: students can NEVER modify their own points
      allow create, update: if isValidId(uid) && isAdmin() && isValidLeaderboardEntry(incoming(), uid);
      allow delete: if isValidId(uid) && isAdmin();
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list, write: if false;
    }
  }
}
